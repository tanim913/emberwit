<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust store only. Certificate pinning for the catalog
     host is enforced in Dart (dio) so it behaves the same on iOS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
