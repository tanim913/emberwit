<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Flutter's first frame (Android 8 to 11): the app
     canvas color (light or night) with the Emberwit mark in the center. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/canvas" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_mark" />
    </item>
</layer-list>
