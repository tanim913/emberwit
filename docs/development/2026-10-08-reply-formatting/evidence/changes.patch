+import 'package:emberwit/core/catalog/model_catalog.dart';
+import 'package:emberwit/core/models/model_library.dart';
+import 'package:emberwit/core/recommendation/model_recommendation.dart';
+import 'package:emberwit/features/model_manager/presentation/models_controller.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../../../fixtures/catalog_fixtures.dart';
+import '../../../fixtures/device_fixtures.dart';
+
+InstalledModel _installed(CatalogEntry entry) => InstalledModel(
+  id: entry.id,
+  displayName: entry.displayName,
+  fileName: '${entry.id}.gguf',
+  sizeBytes: entry.fileSizeBytes,
+  sha256: entry.sha256,
+  verification: ModelVerification.verified,
+  installedAt: DateTime.utc(2026),
+  catalogEntry: entry,
+);
+
+CatalogSnapshot _snapshot(List<CatalogEntry> entries) => CatalogSnapshot(
+  catalog: ModelCatalog(
+    schemaVersion: 1,
+    catalogVersion: 2,
+    generatedAt: DateTime.utc(2026),
+    models: entries,
+  ),
+  source: CatalogSource.cache,
+  loadedAt: DateTime.utc(2026),
+);
+
+void main() {
+  test(
+    'saved metadata survives registry JSON and removal from the catalog',
+    () {
+      final original = _installed(entry());
+      final restored = InstalledModel.fromJson(original.toJson());
+      final state = ModelsState(catalog: _snapshot([]), profile: profile());
+      expect(state.entryForInstalled(restored), original.catalogEntry);
+      expect(state.recommendationForInstalled(restored), isNotNull);
+    },
+  );
+
+  test('installed recommendations do not require download storage', () {
+    final model = _installed(entry(size: 100000000));
+    final state = ModelsState(profile: profile(freeStorageBytes: 0));
+    final recommendation = state.recommendationForInstalled(model)!;
+    expect(recommendation.label, RecommendationLabel.recommended);
+    expect(recommendation.reasons.whereType<NotEnoughStorage>(), isEmpty);
+  });
+
+  test('saved metadata wins over a different current catalog entry', () {
+    final model = _installed(entry());
+    final changed = entry().copyWith(
+      description: const {'en': 'New file, different information'},
+    );
+    final state = ModelsState(catalog: _snapshot([changed]));
+    expect(state.entryForInstalled(model), model.catalogEntry);
+  });
+
+  test('legacy verified records only match catalog metadata by hash', () {
+    final catalogEntry = entry();
+    final model = _installed(catalogEntry).copyWith(catalogEntry: null);
+    final state = ModelsState(catalog: _snapshot([catalogEntry]));
+    expect(state.entryForInstalled(model), catalogEntry);
+    expect(
+      state.entryForInstalled(model.copyWith(sha256: 'different')),
+      isNull,
+    );
+    expect(
+      state.entryForInstalled(
+        model.copyWith(verification: ModelVerification.unverified),
+      ),
+      isNull,
+    );
+  });
+
+  test('missing metadata and missing profiles have no fabricated speed', () {
+    final model = _installed(entry());
+    expect(const ModelsState().recommendationForInstalled(model), isNull);
+    expect(
+      ModelsState(profile: profile())
+          .recommendationForInstalled(model.copyWith(catalogEntry: null)),
+      isNull,
+    );
+  });
+}
