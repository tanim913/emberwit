+import 'package:flutter/material.dart';
+import 'package:flutter_markdown_plus/flutter_markdown_plus.dart';
+import 'package:flutter_math_fork/flutter_math.dart';
+import 'package:markdown/markdown.dart' as md;
+
+/// Math delimiters, parsed before Markdown consumes backslash escapes.
+///
+/// Code spans and fenced code are handled by Markdown itself. Dollar math
+/// requires non-space boundaries and cannot end just before a digit, so
+/// ordinary prices such as `$10 and $20` remain text.
+class ReplyMathInlineSyntax extends md.InlineSyntax {
+  /// Creates the syntax.
+  new() : super(r'\$\$|\$(?!\$)|\\\(|\\\[');
+
+  @override
+  bool tryMatch(md.InlineParser parser, [int? startMatchPos]) {
+    final start = startMatchPos ?? parser.pos;
+    final match = pattern.matchAsPrefix(parser.source, start);
+    if (match == null || _escaped(parser.source, start)) return false;
+    final opener = match[0]!;
+    if (opener == r'$' && start > 0 && parser.source[start - 1] == r'$') {
+      return false;
+    }
+    final closer = switch (opener) {
+      r'\(' => r'\)',
+      r'\[' => r'\]',
+      _ => opener,
+    };
+    final bodyStart = start + opener.length;
+    final source = parser.source;
+    var end = bodyStart;
+    while (end < source.length && source[end] != '\n') {
+      if (source.startsWith(closer, end) && !_escaped(source, end)) break;
+      end++;
+    }
+    final closed = source.startsWith(closer, end);
+    if (!closed) {
+      // Preserve explicit, unfinished TeX while tokens are still arriving.
+      // A lone dollar can be currency, so leave it to the normal parser.
+      if (opener == r'$') return false;
+      parser
+        ..writeText()
+        ..addNode(md.Text(source.substring(start, end)))
+        ..consume(end - start);
+      return true;
+    }
+    final expression = source.substring(bodyStart, end);
+    if (expression.trim().isEmpty) return false;
+    if (opener == r'$' &&
+        (expression.trim() != expression ||
+            (end + 1 < source.length &&
+                RegExp(r'\d').hasMatch(source[end + 1])))) {
+      return false;
+    }
+    final element = md.Element.text('math-inline', expression);
+    element.attributes['source'] = source.substring(start, end + closer.length);
+    element.attributes['display'] = (opener != r'$' && opener != r'\(')
+        .toString();
+    parser
+      ..writeText()
+      ..addNode(element)
+      ..consume(end + closer.length - start);
+    return true;
+  }
+
+  @override
+  bool onMatch(md.InlineParser parser, Match match) => false;
+}
+
+bool _escaped(String source, int offset) {
+  var slashes = 0;
+  for (var i = offset - 1; i >= 0 && source[i] == r'\'; i--) {
+    slashes++;
+  }
+  return slashes.isOdd;
+}
+
+/// Display equations on their own lines, including multiline environments.
+class ReplyMathBlockSyntax extends md.BlockSyntax {
+  /// Creates the syntax.
+  const new();
+
+  @override
+  RegExp get pattern => RegExp(r'^ {0,3}(\$\$|\\\[)');
+
+  @override
+  md.Node parse(md.BlockParser parser) {
+    final first = parser.current.content;
+    final match = pattern.firstMatch(first)!;
+    final opener = match[1]!;
+    final closer = opener == r'$$' ? r'$$' : r'\]';
+    final raw = <String>[];
+    final body = <String>[];
+    var line = first.substring(match.end);
+    while (!parser.isDone) {
+      raw.add(parser.current.content);
+      final end = line.lastIndexOf(closer);
+      if (end >= 0 &&
+          !_escaped(line, end) &&
+          line.substring(end + closer.length).trim().isEmpty) {
+        body.add(line.substring(0, end));
+        parser.advance();
+        final element = md.Element.text('math-block', body.join('\n').trim());
+        element.attributes['source'] = raw.join('\n');
+        return element;
+      }
+      body.add(line);
+      parser.advance();
+      if (!parser.isDone) line = parser.current.content;
+    }
+    // Do not ask Markdown to interpret incomplete equations as emphasis,
+    // links or HTML. Keep the source visible until a closing token arrives.
+    return md.Element('p', [md.Text(raw.join('\n'))]);
+  }
+}
+
+/// Builds offline equations inside the existing Markdown widget tree.
+class ReplyMathBuilder extends MarkdownElementBuilder {
+  /// Creates an inline or display equation builder.
+  new({required this.maxWidth, this.block = false});
+
+  /// Available width, including for embedded inline widgets.
+  final double maxWidth;
+
+  /// Whether the element occupies its own block.
+  final bool block;
+
+  @override
+  bool isBlockElement() => block;
+
+  @override
+  Widget visitElementAfterWithContext(
+    BuildContext context,
+    md.Element element,
+    TextStyle? preferredStyle,
+    TextStyle? parentStyle,
+  ) => Padding(
+    padding: block ? const EdgeInsets.symmetric(vertical: 8) : EdgeInsets.zero,
+    child: _ReplyEquation(
+      expression: element.textContent,
+      source: element.attributes['source'] ?? element.textContent,
+      display: block || element.attributes['display'] == 'true',
+      maxWidth: maxWidth,
+      style: parentStyle ?? Theme.of(context).textTheme.bodyMedium!,
+    ),
+  );
+}
+
+class _ReplyEquation extends StatefulWidget {
+  const new({
+    required this.expression,
+    required this.source,
+    required this.display,
+    required this.maxWidth,
+    required this.style,
+  });
+
+  final String expression;
+  final String source;
+  final bool display;
+  final double maxWidth;
+  final TextStyle style;
+
+  @override
+  State<_ReplyEquation> createState() => _ReplyEquationState();
+}
+
+class _ReplyEquationState extends State<_ReplyEquation> {
+  Math? _parsed;
+
+  @override
+  void initState() {
+    super.initState();
+    _parse();
+  }
+
+  @override
+  void didUpdateWidget(_ReplyEquation oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (widget.expression != oldWidget.expression) _parse();
+  }
+
+  void _parse() {
+    // Bound work for untrusted model output. Reuse the parsed tree when
+    // streaming changes another part of the reply, or the theme changes.
+    _parsed = widget.expression.length > 8192
+        ? null
+        : Math.tex(
+            widget.expression,
+            settings: const TexParserSettings(
+              maxExpand: 100,
+              strict: Strict.ignore,
+            ),
+          );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final parsed = _parsed;
+    final child = parsed == null
+        ? Text(widget.source, style: widget.style)
+        : Math(
+            ast: parsed.ast,
+            parseError: parsed.parseError,
+            mathStyle: widget.display ? MathStyle.display : MathStyle.text,
+            textStyle: widget.style,
+            onErrorFallback: (_) => Text(widget.source, style: widget.style),
+          );
+    return Semantics(
+      label: widget.source,
+      child: ExcludeSemantics(
+        child: ConstrainedBox(
+          constraints: BoxConstraints(maxWidth: widget.maxWidth),
+          child: SingleChildScrollView(
+            scrollDirection: Axis.horizontal,
+            child: child,
+          ),
+        ),
+      ),
+    );
+  }
+}
