+  /// Running an installed model does not require space to download it again.
+  ModelRecommendation? recommendationForInstalled(InstalledModel model) {
+    final entry = entryForInstalled(model);
+    final device = profile;
+    if (entry == null || device == null) return null;
+    return const RecommendationEngine().recommend(
+      entry.toSpec(isInstalled: true),
+      device,
+    );
+  }
