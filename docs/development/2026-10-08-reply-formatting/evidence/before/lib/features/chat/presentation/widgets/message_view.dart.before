import 'dart:async';

import 'package:emberwit/core/l10n/l10n_extension.dart';
import 'package:emberwit/core/widgets/action_colors.dart';
import 'package:emberwit/features/chat/domain/chat_models.dart';
import 'package:emberwit/features/chat/domain/chat_template.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_markdown_plus/flutter_markdown_plus.dart';
import 'package:markdown/markdown.dart' as md;
import 'package:url_launcher/url_launcher.dart';

/// Opens [uri] externally. Replaced in tests.
typedef LinkOpener = Future<bool> Function(Uri uri);

/// Default [LinkOpener]: the system browser.
Future<bool> openExternally(Uri uri) =>
    launchUrl(uri, mode: LaunchMode.externalApplication);

/// Schemes a link in a reply may use; anything else is never opened.
const Set<String> allowedLinkSchemes = {'http', 'https', 'mailto'};

/// One message in a conversation.
///
/// Model output is untrusted: it is rendered as markdown without HTML (tags
/// are shown as text), images are never fetched (a placeholder is shown),
/// and links open only after the user confirms the exact address.
class MessageView extends StatelessWidget {
  /// Creates the view.
  const new({
    required this.message,
    this.streaming = false,
    this.openLink = openExternally,
    super.key,
  });

  /// The message.
  final ChatMessage message;

  /// Whether this reply is being generated right now.
  final bool streaming;

  /// Opens a confirmed link.
  final LinkOpener openLink;

  @override
  Widget build(BuildContext context) =>
      message.role == MessageRole.user ? _userBubble(context) : _reply(context);

  Widget _userBubble(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;
    return Semantics(
      label: context.l10n.chatYou,
      child: Align(
        alignment: AlignmentDirectional.centerEnd,
        child: ConstrainedBox(
          constraints: BoxConstraints(
            maxWidth: MediaQuery.sizeOf(context).width * 0.85,
          ),
          child: DecoratedBox(
            decoration: BoxDecoration(
              color: scheme.primaryContainer,
              borderRadius: const BorderRadiusDirectional.only(
                topStart: Radius.circular(18),
                topEnd: Radius.circular(18),
                bottomStart: Radius.circular(18),
                bottomEnd: Radius.circular(4),
              ).resolve(Directionality.of(context)),
            ),
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
              child: SelectableText(
                message.content,
                style: TextStyle(color: scheme.onPrimaryContainer),
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _reply(BuildContext context) {
    final l10n = context.l10n;
    final theme = Theme.of(context);
    final text = stripThinking(message.content);
    final meta = theme.textTheme.bodySmall?.copyWith(
      color: theme.colorScheme.onSurfaceVariant,
    );
    final stats = message.stats;
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        if (message.droppedMessages > 0)
          Padding(
            padding: const EdgeInsets.only(bottom: 8),
            child: Row(
              children: [
                Icon(
                  Icons.history_toggle_off_rounded,
                  size: 16,
                  color: theme.colorScheme.tertiary,
                ),
                const SizedBox(width: 6),
                Expanded(
                  child: Text(
                    l10n.chatContextTrimmed(message.droppedMessages),
                    style: meta,
                  ),
                ),
              ],
            ),
          ),
        if (text.isEmpty && streaming)
          Row(
            children: [
              const SizedBox.square(
                dimension: 14,
                child: CircularProgressIndicator(strokeWidth: 2),
              ),
              const SizedBox(width: 8),
              Text(l10n.chatReading, style: meta),
            ],
          )
        else
          ReplyMarkdown(text: text, openLink: openLink),
        if (!streaming)
          Row(
            children: [
              if (message.status == MessageStatus.stopped)
                _Tag(Icons.stop_circle_outlined, l10n.chatStopped),
              if (message.status == MessageStatus.failed)
                _Tag(Icons.error_outline_rounded, l10n.chatReplyFailed),
              if (stats != null)
                Expanded(
                  child: Text(
                    l10n.chatStats(
                      stats.tokensPerSecond,
                      stats.timeToFirstTokenMs,
                      stats.totalTokens,
                    ),
                    style: meta,
                  ),
                )
              else
                const Spacer(),
              if (text.isNotEmpty)
                IconButton(
                  tooltip: l10n.chatCopy,
                  visualDensity: VisualDensity.compact,
                  icon: const Icon(Icons.copy_rounded, size: 18),
                  onPressed: () => _copy(context, text),
                ),
            ],
          ),
      ],
    );
  }
}

class _Tag extends StatelessWidget {
  const new(this.icon, this.label);

  final IconData icon;
  final String label;

  @override
  Widget build(BuildContext context) {
    final color = Theme.of(context).colorScheme.onSurfaceVariant;
    return Padding(
      padding: const EdgeInsetsDirectional.only(end: 8),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(icon, size: 16, color: color),
          const SizedBox(width: 4),
          Text(label, style: Theme.of(context).textTheme.bodySmall),
        ],
      ),
    );
  }
}

Future<void> _copy(BuildContext context, String text) async {
  await Clipboard.setData(ClipboardData(text: text));
  if (!context.mounted) return;
  ScaffoldMessenger.of(context)
    ..hideCurrentSnackBar()
    ..showSnackBar(SnackBar(content: Text(context.l10n.chatCopied)));
}

/// Markdown for model replies: GitHub flavoured, no HTML, no remote images,
/// confirmed links, code blocks with a copy button.
class ReplyMarkdown extends StatelessWidget {
  /// Creates the renderer.
  const new({required this.text, this.openLink = openExternally, super.key});

  /// Markdown source (untrusted).
  final String text;

  /// Opens a confirmed link.
  final LinkOpener openLink;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final scheme = theme.colorScheme;
    return MarkdownBody(
      data: text,
      selectable: true,
      // Tried before the built-in HTML block syntax, which cannot be
      // removed: raw HTML blocks become visible plain text.
      blockSyntaxes: const [HtmlBlockAsTextSyntax()],
      extensionSet: md.ExtensionSet(
        md.ExtensionSet.gitHubFlavored.blockSyntaxes
            .where((s) => s is! md.HtmlBlockSyntax)
            .toList(),
        md.ExtensionSet.gitHubFlavored.inlineSyntaxes
            .where((s) => s is! md.InlineHtmlSyntax)
            .toList(),
      ),
      styleSheet: MarkdownStyleSheet.fromTheme(theme).copyWith(
        code: theme.textTheme.bodyMedium
            ?.merge(monospaceText)
            .copyWith(backgroundColor: scheme.surfaceContainerHighest),
        // The code block builder draws its own container.
        codeblockDecoration: const BoxDecoration(),
        codeblockPadding: EdgeInsets.zero,
        a: TextStyle(
          color: scheme.primary,
          decoration: TextDecoration.underline,
          decorationColor: scheme.primary,
        ),
      ),
      builders: {'pre': _CodeBlockBuilder()},
      imageBuilder: (uri, title, alt) => Text(
        context.l10n.chatImageBlocked(alt ?? title ?? uri.host),
        style: theme.textTheme.bodySmall?.copyWith(
          color: scheme.onSurfaceVariant,
          fontStyle: FontStyle.italic,
        ),
      ),
      onTapLink: (label, href, title) {
        if (href != null) {
          unawaited(confirmAndOpenLink(context, href, openLink));
        }
      },
    );
  }
}

/// Parses raw HTML blocks like the standard syntax, but emits them as a
/// plain text paragraph. Model output is never interpreted as HTML, and
/// nothing it writes is silently hidden either.
class HtmlBlockAsTextSyntax extends md.HtmlBlockSyntax {
  /// Creates the syntax.
  const new();

  @override
  md.Node parse(md.BlockParser parser) {
    final raw = super.parse(parser);
    final text = raw is md.Text ? raw.text.trim() : raw.textContent.trim();
    return md.Element('p', [md.Text(text)]);
  }
}

/// Shows the full address of a link from a reply and opens it only if the
/// user confirms. Unsupported schemes (for example `javascript:` or
/// `file:`) are ignored.
Future<void> confirmAndOpenLink(
  BuildContext context,
  String href,
  LinkOpener openLink,
) async {
  final uri = Uri.tryParse(href.trim());
  if (uri == null || !allowedLinkSchemes.contains(uri.scheme)) return;
  final l10n = context.l10n;
  final confirmed = await showDialog<bool>(
    context: context,
    builder: (context) => AlertDialog(
      title: Text(l10n.chatLinkTitle),
      content: SelectableText(l10n.chatLinkBody(uri.toString())),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context, false),
          child: Text(l10n.commonCancel),
        ),
        FilledButton(
          key: const Key('open-link'),
          onPressed: () => Navigator.pop(context, true),
          child: Text(l10n.chatLinkOpen),
        ),
      ],
    ),
  );
  if (confirmed ?? false) await openLink(uri);
}

class _CodeBlockBuilder extends MarkdownElementBuilder {
  @override
  bool isBlockElement() => true;

  @override
  Widget? visitElementAfterWithContext(
    BuildContext context,
    md.Element element,
    TextStyle? preferredStyle,
    TextStyle? parentStyle,
  ) {
    final code = element.textContent.trimRight();
    final theme = Theme.of(context);
    final scheme = theme.colorScheme;
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: DecoratedBox(
        decoration: BoxDecoration(
          color: scheme.surfaceContainerHighest,
          borderRadius: BorderRadius.circular(10),
          border: Border.all(color: scheme.outlineVariant),
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Align(
              alignment: AlignmentDirectional.centerEnd,
              child: IconButton(
                key: const Key('copy-code'),
                tooltip: context.l10n.chatCopyCode,
                visualDensity: VisualDensity.compact,
                icon: const Icon(Icons.copy_all_rounded, size: 18),
                onPressed: () => _copy(context, code),
              ),
            ),
            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.fromLTRB(12, 0, 12, 12),
              child: SelectableText(
                code,
                style: theme.textTheme.bodySmall
                    ?.merge(monospaceText)
                    .copyWith(color: scheme.onSurface),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
