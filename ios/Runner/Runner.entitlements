<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Raises the per-app memory limit so larger models fit. The model
	     recommendation engine assumes it (50% of RAM on iOS). The App ID
	     needs the "Increased Memory Limit" capability for signed builds. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
